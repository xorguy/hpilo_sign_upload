# HP iLO 4 certificate upload — runtime configuration
# Copy this file to .env, fill in the values, and run: chmod 600 .env
# NEVER commit .env to version control.

# iLO management interface IP or hostname
ILO_HOST=192.168.x.x

# iLO username (must have config_ilo_priv)
ILO_USER=Administrator

# iLO password
ILO_PASS=your_ilo_password

# Optional: absolute path to the HOST-SIDE DIRECTORY containing ilo.csr.
# When set, the CSR is read from that file (the directory is mounted read-only
# at /csr inside the container). When left unset, the CSR is downloaded
# automatically from iLO — a CSR must have been generated there first via the
# iLO web interface or RIBCL/REST API.
# CSR_DIR=/path/to/directory/containing/ilo.csr
